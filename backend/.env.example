# PostgreSQL connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/atech_hrm?schema=public
# Neon:   lấy chuỗi kết nối từ dashboard Neon (nhớ có ?sslmode=require)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atech_hrm?schema=public"

# Cổng chạy API
PORT=4000

# Môi trường: development | production
NODE_ENV=development

# CORS: địa chỉ frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS="http://localhost:5173"

# Khoá ký JWT cho đăng nhập (ít nhất 32 ký tự). Tạo chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
JWT_EXPIRES_IN=8h

# Mật khẩu tài khoản admin do `npm run seed` tạo (đổi ngay sau lần đăng nhập đầu)
SEED_ADMIN_PASSWORD="Admin@123456"

# GHI CHÚ: sau khi chạy `npm run prisma:migrate`, chạy thêm file
# prisma/migrations/manual_partial_unique_indexes.sql để tạo các partial
# unique index (duy nhất khi chưa xóa mềm):
#   psql "$DATABASE_URL" -f prisma/migrations/manual_partial_unique_indexes.sql

# Địa chỉ giao diện web (link đặt lại mật khẩu trong email)
APP_URL="http://localhost:5173"

# Gửi email quên mật khẩu (tuỳ chọn). Để trống thì link được in ra log server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ATECH HRM <no-reply@congty.vn>"
